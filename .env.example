# Copy this file to .env and put your real values there. Never commit .env.
# The token can also be supplied directly via the environment (preferred for
# systemd: EnvironmentFile=.../telegram-pc-remote.env, or a container secret).

# Required: bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional overrides
# DATA_DIR=./data                 # where commands.json / whitelist.json live
# COMMANDS_DIR=./commands         # where the user-authored .sh scripts live
# BOT_RELOAD_SECONDS=5            # how often config files are rechecked
# BOT_MAX_CONCURRENT=4            # max updates processed in parallel
# BOT_MAX_COMMAND_SECONDS=600     # hard cap per command execution